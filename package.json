{
  "name": "inw",
  "version": "1.0.0",
  "description": "Save and run shell commands by name, globally or per project",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "inw": "dist/index.js"
  },
  "files": [
    "dist",
    "contracts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest && npm run test:shell",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:shell": "npm run build && bash tests/shell/wrapper.test.sh && bash tests/shell/surface.test.sh"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "^2.0.1",
    "ink": "^4.0.0",
    "meow": "^12.0.0",
    "react": "^18.0.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
